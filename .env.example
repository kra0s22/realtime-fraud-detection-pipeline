# =============================================================================
# Realtime Fraud Detection Pipeline - Environment Configuration
# Copy this file to `.env` and adjust values as needed.
# All variables have safe defaults in docker-compose.yml, so `.env` is optional.
# =============================================================================

# --- Event Broker (Redpanda / Kafka) ---
REDPANDA_BOOTSTRAP_SERVERS=redpanda:29092
REDPANDA_ADMIN_ADDR=redpanda:9644

# --- Topics ---
FRAUD_TOPIC=transactions.raw
ALERTS_TOPIC=transactions.alerts

# --- Fraud Alerter ---
ALERT_THRESHOLD=0.5
ALERTER_GROUP=fraud-alerter

# --- Redis Feature Store ---
REDIS_HOST=redis
REDIS_PORT=6379

# --- MLflow ---
MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_MODEL_NAME=fraud-detector

# --- Spark / Delta Lake ---
SPARK_MASTER=spark://spark-master:7077
DELTA_TABLE_PATH=/opt/spark/work-dir/delta/transactions
CHECKPOINT_LOCATION=/opt/spark/work-dir/delta/checkpoints/transactions

# --- Producer ---
TRANSACTIONS_PER_SECOND=10

# --- ML Training ---
TRAIN_N_TRANSACTIONS=20000
FRAUD_RATE=0.02
SEED=42
TRAIN_USE_DELTA=true
DELTA_TABLE_PATH=/opt/spark/work-dir/delta/transactions

# --- Real-data training (src/ml/real.py) ---
MODEL_TYPE=logistic_regression
REAL_DATA_PATH=/app/data/creditcard.csv
# Empty -> UCI default schema (V1..V28, Amount)
REAL_FEATURE_COLUMNS=
REAL_LABEL_COLUMN=Class
REAL_MODEL_TYPE=random_forest
REAL_MODEL_NAME=fraud-detector-real

# --- Batch prediction ---
BATCH_MODEL_NAME=fraud-detector
BATCH_ALIAS=Production
BATCH_THRESHOLD=0.5
BATCH_BUILD_FEATURES=false

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
