# =============================================================================
# Realtime Fraud Detection Pipeline - Environment Configuration
# Copy this file to `.env` and adjust values as needed.
# All variables have safe defaults in docker-compose.yml, so `.env` is optional.
# =============================================================================

# --- Event Broker (Redpanda / Kafka) ---
REDPANDA_BOOTSTRAP_SERVERS=redpanda:29092
REDPANDA_ADMIN_ADDR=redpanda:9644

# --- Topics ---
FRAUD_TOPIC=transactions.raw
ALERTS_TOPIC=transactions.alerts

# --- Fraud Alerter ---
ALERT_THRESHOLD=0.5
ALERTER_GROUP=fraud-alerter

# --- Redis Feature Store ---
REDIS_HOST=redis
REDIS_PORT=6379

# --- MLflow ---
MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_MODEL_NAME=fraud-detector

# --- Spark / Delta Lake ---
SPARK_MASTER=spark://spark-master:7077
DELTA_TABLE_PATH=/opt/spark/work-dir/delta/transactions
CHECKPOINT_LOCATION=/opt/spark/work-dir/delta/checkpoints/transactions

# --- Producer ---
TRANSACTIONS_PER_SECOND=10

# --- ML Training ---
TRAIN_N_TRANSACTIONS=20000
FRAUD_RATE=0.02
SEED=42

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
